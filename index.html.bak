  <main role="main">
    <!-- ==========================================================================
         Hero Section & AI Omnibox Search
         ========================================================================== -->
    <section class="hero-section">
      <div class="container">
        <!-- Animated Background Mesh Orbs -->
        <div class="hero-bg-mesh" aria-hidden="true">
          <div class="hero-mesh-orb hero-orb-1"></div>
          <div class="hero-mesh-orb hero-orb-2"></div>
          <div class="hero-mesh-orb hero-orb-3"></div>
        </div>
        <!-- Floating Emoji Particle System -->
        <div class="hero-particles" aria-hidden="true" id="heroParticles"></div>

        <!-- Personalized Welcome Pill -->
        <div class="hero-pill-badge">
          <span class="pulse-dot"></span>
          <span id="heroUserGreeting">Good evening, <span class="gradient-text">Chethan</span></span>
          <span style="color: var(--text-muted);">•</span>
          <span>India's AI-Powered Hyper-Local Platform</span>
        </div>

        <h1 class="hero-title">
          Find <span class="gradient-text-animated">Trusted Pros</span>.<br>
          <span class="gradient-text hero-title-accent">Anywhere in India.</span>
        </h1>

        <p class="hero-subtitle" style="transition-delay:0.1s">
          India's smartest local services platform. 15,000+ police-verified professionals, instant AI quotes, real-time
          GPS tracking — across every city and village.
        </p>
        <div class="hero-live-stats-strip">
          <div class="hero-stat-chip">
            <span class="hero-stat-num">210+</span>
            <span class="hero-stat-label">Verified Businesses</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat-chip">
            <span class="hero-stat-num">12</span>
            <span class="hero-stat-label">Cities &amp; Villages</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat-chip">
            <span class="hero-stat-num">4.8★</span>
            <span class="hero-stat-label">Average Rating</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat-chip">
            <span class="hero-stat-num live-pulse-num" id="liveProCount">160+</span>
            <span class="hero-stat-label"><span class="live-indicator-dot"></span> Live Pros</span>
          </div>
        </div>

        <!-- Hero Feature Shortcut Pills -->
        <div class="hero-feature-pills-row">
          <button class="hero-feature-pill arena-pill" onclick="window.QuoteArena.openArena()">
            <span data-react-icon="flame" data-icon-size="14"></span> Live Bidding Arena
          </button>
          <button class="hero-feature-pill" onclick="window.CostEstimator.openEstimator()">
            <span data-react-icon="rupee" data-icon-size="14"></span> Smart Cost Estimator
          </button>
          <button class="hero-feature-pill" onclick="window.ProComparison.openModal()">
            <span data-react-icon="scale" data-icon-size="14"></span> Compare Pros Side-by-Side
          </button>
          <button class="hero-feature-pill" onclick="window.ShieldGuarantee.openShieldModal()">
            <span data-react-icon="shield" data-icon-size="14"></span> ₹10,000 Quality Shield
          </button>
          <button class="hero-feature-pill" onclick="window.CareAI.launchDiagnosticWizard('health')">
            <span data-react-icon="stethoscope" data-icon-size="14"></span> Symptom Wizard
          </button>
        </div>

        <!-- Powerful AI Omnibox Search -->
        <div class="search-omnibox-wrapper">
          <div class="omnibox-card">
            <div class="omnibox-city-prefix" id="omniboxCityPrefix"
              onclick="document.getElementById('locationBtn').click()" title="Click to change city" role="button"
              tabindex="0">
              <span data-react-icon="mapPin" data-icon-size="14"></span> In <span>Bengaluru</span> <span
                class="city-prefix-arrow" data-react-icon="chevronDown" data-icon-size="11"></span>
            </div>

            <div class="omnibox-input-group">
              <span class="omnibox-search-icon" data-react-icon="search" data-icon-size="18"></span>
              <input type="text" id="omniboxInput" class="omniboxInput omnibox-input"
                placeholder="Ask anything: 'AC repair today', 'Dentist under ₹500', 'Plumber in Valachil'..."
                autocomplete="off" aria-label="Search local services using natural language AI" />
              <button class="omnibox-clear-btn" id="omniboxClearBtn" title="Clear search" data-react-icon="x"
                data-icon-size="14"></button>
              <button class="omnibox-mic-btn" id="omniboxMicBtn" onclick="window.VoiceSearch.startListening()"
                title="Search with Voice (Microphone)" data-react-icon="mic" data-icon-size="16">
              </button>
            </div>

            <button class="omnibox-submit-btn" id="omniboxSubmitBtn">
              <span>Smart Search</span>
              <span>➔</span>
            </button>
          </div>

          <!-- Real-Time Autocomplete Suggestions -->
          <div class="search-suggestions-dropdown" id="searchSuggestions">
            <!-- Populated dynamically -->
          </div>
        </div>

        <!-- Quick Search Tags & Natural Language Suggestions -->
        <div class="quick-tags-container" id="quickTagsContainer">
          <!-- Populated dynamically -->
        </div>

