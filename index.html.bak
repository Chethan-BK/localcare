<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LocalCare Infinity X — India's #1 AI-Powered Local Services Platform</title>
  <meta name="description"
    content="LocalCare Infinity connects you with verified doctors, AC technicians, plumbers, restaurants, salons, and 24/7 emergency services across 10 Indian hubs. Search with natural language AI, compare instant quotes, and track doorstep technicians in real-time." />
  <meta name="keywords"
    content="LocalCare Infinity, local services, AC repair, plumbers near me, doctors near me, dentist under 500, Valachil Mangalore, bangalore services, emergency ambulance 108" />

  <!-- Open Graph / SEO -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="LocalCare Infinity X - Your City. Your Needs. One Smart Search." />
  <meta property="og:description"
    content="India's next-generation AI-powered local discovery, appointment booking, and doorstep services platform. Discover, compare prices, book verified services, and track doorstep pros in real-time." />
  <meta property="og:site_name" content="LocalCare Infinity" />

  <!-- Google Fonts Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet" />

  <!-- Leaflet Whole India & Rural Village Geospatial Mapping Engine -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <!-- Stylesheets (v4.0.0 - Ultra Premium Engine) -->
  <link rel="stylesheet" href="css/variables.css?v=4.0.0" />
  <link rel="stylesheet" href="css/style.css?v=4.0.0" />
  <link rel="stylesheet" href="css/ultra.css?v=4.0.0" />

  <!-- Instant Cache Refresh & Service Worker Sync -->
  <script>
    (function () {
      if ('caches' in window) {
        caches.keys().then(function (names) {
          names.forEach(function (name) {
            if (name !== 'localcare-infinity-v3.3.0') {
              caches.delete(name);
            }
          });
        });
      }
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function (registrations) {
          for (var reg of registrations) {
            reg.update();
          }
        });
      }
    })();
  </script>

  <!-- Progressive Web App (PWA) Manifest & Meta -->
  <meta name="theme-color" content="#ff6800" />
  <link rel="manifest" href="manifest.json" />
  <link rel="icon" type="image/svg+xml" href="icons/icon.svg" />
  <link rel="apple-touch-icon" href="icons/icon.svg" />

  <!-- LocalBusiness Schema JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "LocalCare Infinity",
    "alternateName": "LocalCare",
    "url": "https://localcare.in",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://localcare.in/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
</head>

<body>

  <!-- Scroll Progress Indicator -->
  <div class="scroll-progress-bar" id="scrollProgressBar" role="progressbar" aria-label="Page scroll progress"
    aria-valuemin="0" aria-valuemax="100"></div>

  <!-- ==========================================================================
       Apple-Style Dynamic Island Live Activity HUD (Interactive Expandable)
       ========================================================================== -->
  <aside class="dynamic-island-container" id="dynamicIslandContainer" aria-label="Live Activity Status">
    <div class="dynamic-island" id="dynamicIsland" onclick="window.LocalCare.toggleDynamicIsland(event)">
      <!-- Compact Idle Pill -->
      <div class="island-compact" id="islandCompact">
        <div class="island-left">
          <span class="island-icon-pulse">⚡</span>
          <span class="island-text-marquee">160+ Verified Pros Online across 12 Cities</span>
        </div>
        <div class="island-right">
          <span class="island-mini-badge">🔥 LIVE ARENA</span>
        </div>
      </div>

      <!-- Expanded Detailed Card -->
      <div class="island-expanded" id="islandExpanded" style="display: none;">
        <div class="island-exp-header">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span class="island-exp-dot"></span>
            <strong>Active Doorstep Dispatch Radar</strong>
          </div>
          <button class="island-close-sm"
            onclick="event.stopPropagation(); window.LocalCare.collapseDynamicIsland();">✕</button>
        </div>

        <div class="island-exp-body">
          <div class="island-status-row">
            <div class="island-tech-avatar-box">
              <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80"
                alt="Tech" class="island-tech-img" />
              <span class="island-avatar-badge">✓</span>
            </div>
            <div>
              <div class="island-tech-name">Suresh Gowda • Master HVAC</div>
              <div class="island-tech-sub">En-route in Koramangala • KA-01-EA-4921</div>
              <div class="island-otp-tag">OTP: <strong>5192</strong> (Share at Doorstep)</div>
            </div>
            <div class="island-eta-badge">
              <span class="eta-num">12</span>
              <span class="eta-unit">MINS</span>
            </div>
          </div>

          <div class="island-exp-actions">
            <button class="action-btn action-btn-primary island-action-btn"
              onclick="event.stopPropagation(); window.QuoteArena.openArena();">
              🔥 Open Live Arena
            </button>
            <button class="action-btn action-btn-outline island-action-btn"
              onclick="event.stopPropagation(); window.TrackingEngine.openTrackingModal();">
              🗺️ Track on GPS Map
            </button>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <!-- ==========================================================================
       Unified Top Announcement & Live Pulse Activity Bar
       ========================================================================== -->
  <aside class="platform-announcement-bar" id="livePulseTickerBar" aria-label="Platform Updates and Emergency">
    <div class="container announcement-bar-inner">
      <div class="announcement-left">
        <span class="announcement-badge">
          <span class="live-dot-pulse"></span> LIVE
        </span>
        <div class="announcement-ticker-marquee">
          <div class="pulse-ticker-content" id="pulseTickerTrack">
            <span>⚡ <strong>Priya K.</strong> booked Apollo Dental in Koramangala (2m ago)</span>
            <span class="ticker-divider">•</span>
            <span>🔧 <strong>Ramesh N.</strong> received 3 verified bids for Plumbing in Valachil (4m ago)</span>
            <span class="ticker-divider">•</span>
            <span>🛡️ <strong>15,480+</strong> Businesses 100% Police & GST Verified</span>
            <span class="ticker-divider">•</span>
            <span>🔥 <strong>Suresh G.</strong> completed AC Power Jet Service (5.0★)</span>
            <span class="ticker-divider">•</span>
            <span>❄️ <strong>Vikram M.</strong> availed ₹400 OFF on 2BHK Deep Cleaning</span>
          </div>
        </div>
      </div>
      <div class="announcement-right">
        <div class="pulse-city-weather" id="cityWeatherWidget" title="Local conditions in selected city">
          <span id="weatherIcon">🌤️</span>
          <span id="weatherText">Bengaluru 24°C • Clean AQI</span>
        </div>
        <div class="announcement-divider">|</div>
        <button class="announcement-sos-btn" onclick="window.EmergencyMode.openEmergencyModal()"
          title="24/7 SOS Emergency Services">
          <span>🚨</span> <strong>24/7 SOS (108)</strong>
        </button>
      </div>
    </div>
  </aside>

  <!-- ==========================================================================
       Site Header & Global Navigation (Crisp, Sticky, 100% Opaque)
       ========================================================================== -->
  <header class="site-header" role="banner">
    <div class="container header-container">

      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <!-- Mobile Drawer Hamburger Toggle -->
        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open mobile navigation drawer"
          data-react-icon="menu" data-icon-size="20">
        </button>

        <!-- Upgraded Brand Logo (Zero Text-Wrapping / Overlap) -->
        <a href="#" class="brand-logo" aria-label="LocalCare Infinity Home">
          <div class="logo-badge" data-react-icon="mapPin" data-icon-size="20"></div>
          <div class="brand-info-col">
            <div class="brand-title-row">
              <span class="brand-text">Local<span>Care</span></span>
              <span class="infinity-badge"><span data-react-icon="zap" data-icon-size="11"></span> AI Infinity</span>
            </div>
            <span class="brand-tagline-mini">Verified Local Services & AI Concierge</span>
          </div>
        </a>
      </div>

      <!-- Location Selector Dropdown -->
      <div class="location-selector">
        <button class="location-btn" id="locationBtn" aria-haspopup="true" aria-expanded="false"
          title="Change your location">
          <span class="location-icon" data-react-icon="mapPin" data-icon-size="15"></span>
          <span class="location-name" id="currentCityLabel">Bengaluru</span>
          <span class="location-arrow" data-react-icon="chevronDown" data-icon-size="12"></span>
        </button>

        <div class="location-dropdown" id="locationDropdown" role="menu">
          <div style="display: flex; gap: 0.4rem; margin-bottom: 0.5rem;">
            <input type="text" id="citySearchInput" class="dropdown-search" style="margin-bottom: 0;"
              placeholder="Search 100+ Indian cities, states, PIN code..." autocomplete="off" />
            <button class="action-btn action-btn-outline"
              style="padding: 0.4rem 0.6rem; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 0.25rem;"
              onclick="window.LocalCare.autoDetectLocation()" title="Use GPS Location">
              <span data-react-icon="crosshair" data-icon-size="12"></span> GPS
            </button>
          </div>
          <!-- Quick State Filter Pills -->
          <div class="location-state-tabs" id="locationStateTabs">
            <button class="location-tab-btn active" onclick="window.LocalCare.filterLocationByState('ALL')">All India</button>
            <button class="location-tab-btn" onclick="window.LocalCare.filterLocationByState('KA')">Karnataka</button>
            <button class="location-tab-btn" onclick="window.LocalCare.filterLocationByState('MH')">Maharashtra</button>
            <button class="location-tab-btn" onclick="window.LocalCare.filterLocationByState('DL')">Delhi NCR</button>
            <button class="location-tab-btn" onclick="window.LocalCare.filterLocationByState('TN')">Tamil Nadu</button>
            <button class="location-tab-btn" onclick="window.LocalCare.filterLocationByState('TS')">Telangana</button>
            <button class="location-tab-btn" onclick="window.LocalCare.filterLocationByState('KL')">Kerala</button>
            <button class="location-tab-btn" onclick="window.LocalCare.filterLocationByState('GJ')">Gujarat</button>
            <button class="location-tab-btn" onclick="window.LocalCare.filterLocationByState('WB')">West Bengal</button>
            <button class="location-tab-btn" onclick="window.LocalCare.filterLocationByState('RJ')">Rajasthan</button>
          </div>
          <ul class="city-list" id="cityList" role="listbox">
            <!-- Populated dynamically from IndiaLocations -->
          </ul>
        </div>
      </div>

      <!-- Desktop Mega Menu Dropdown -->
      <div class="mega-menu-wrapper" id="megaMenuWrapper">
        <button class="mega-menu-trigger-btn" id="megaMenuTriggerBtn" aria-haspopup="true" aria-expanded="false"
          title="Browse all categories and services" style="display: inline-flex; align-items: center; gap: 0.4rem;">
          <span data-react-icon="grid" data-icon-size="14"></span> <span>Categories & Hubs</span>
          <span data-react-icon="chevronDown" data-icon-size="11"></span>
        </button>

        <div class="desktop-mega-menu" id="desktopMegaMenu">
          <div class="mega-menu-grid">
            <div>
              <div class="mega-col-title"><span>🩺</span> Healthcare & Medical</div>
              <ul class="mega-links-list">
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('health'); document.getElementById('desktopMegaMenu').classList.remove('active');">Dentists
                    & Dental Care</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('health'); document.getElementById('desktopMegaMenu').classList.remove('active');">Dermatologists
                    & Skin</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('health'); document.getElementById('desktopMegaMenu').classList.remove('active');">General
                    Physicians</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('health'); document.getElementById('desktopMegaMenu').classList.remove('active');">Diagnostic
                    Labs & Scans</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.EmergencyMode.triggerEmergency('ambulance'); document.getElementById('desktopMegaMenu').classList.remove('active');">24/7
                    Ambulance (108)</a></li>
              </ul>
            </div>

            <div>
              <div class="mega-col-title"><span>🔧</span> Home & Maintenance</div>
              <ul class="mega-links-list">
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('electrical'); document.getElementById('desktopMegaMenu').classList.remove('active');">AC
                    Service & Gas Refill</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('home'); document.getElementById('desktopMegaMenu').classList.remove('active');">Plumbers
                    & Seepage Fix</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('electrical'); document.getElementById('desktopMegaMenu').classList.remove('active');">Electricians
                    & Wiring</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('cleaning'); document.getElementById('desktopMegaMenu').classList.remove('active');">Deep
                    Cleaning & Pest Control</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('home'); document.getElementById('desktopMegaMenu').classList.remove('active');">Carpenters
                    & Furniture</a></li>
              </ul>
            </div>

            <div>
              <div class="mega-col-title"><span>🚗</span> Auto & Real Estate</div>
              <ul class="mega-links-list">
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('auto'); document.getElementById('desktopMegaMenu').classList.remove('active');">Car
                    Detailing & Wash</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.EmergencyMode.triggerEmergency('towing'); document.getElementById('desktopMegaMenu').classList.remove('active');">24/7
                    Roadside Towing</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('auto'); document.getElementById('desktopMegaMenu').classList.remove('active');">Multi-Brand
                    Garages</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('stays'); document.getElementById('desktopMegaMenu').classList.remove('active');">PG
                    Accommodations</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('stays'); document.getElementById('desktopMegaMenu').classList.remove('active');">Apartment
                    & Flat Rentals</a></li>
              </ul>
            </div>

            <div>
              <div class="mega-col-title"><span>🍽️</span> Food, Tech & Events</div>
              <ul class="mega-links-list">
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('food'); document.getElementById('desktopMegaMenu').classList.remove('active');">Pure
                    Veg Restaurants</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('food'); document.getElementById('desktopMegaMenu').classList.remove('active');">Cafes
                    & Family Dining</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('tech'); document.getElementById('desktopMegaMenu').classList.remove('active');">Laptop
                    & Mobile Repair</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('events'); document.getElementById('desktopMegaMenu').classList.remove('active');">Wedding
                    Photographers</a></li>
                <li class="mega-link-item"><a href="javascript:void(0)"
                    onclick="window.LocalCare.filterCategory('tutor'); document.getElementById('desktopMegaMenu').classList.remove('active');">Home
                    Tutors & Classes</a></li>
              </ul>
            </div>
          </div>

          <div class="mega-menu-footer-strip">
            <span>⚡ Need custom quotes? Broadcast your requirement to 20+ verified pros in 30 seconds.</span>
            <button class="action-btn action-btn-primary" style="padding: 0.35rem 0.85rem; font-size: 0.8rem;"
              onclick="window.QuoteMarketplace.openQuotesModal(); document.getElementById('desktopMegaMenu').classList.remove('active');">
              Broadcast Free Quote ➔
            </button>
          </div>
        </div>
      </div>

      <!-- Action Buttons & Portals -->
      <div class="header-actions">
        <!-- High-Priority Primary CTAs -->
        <div class="header-primary-group">
          <button class="action-btn action-btn-primary header-cta-arena" id="headerQuoteArenaBtn"
            onclick="window.QuoteArena.openArena()" title="Launch Real-Time Pro Reverse-Bidding War">
            <span data-react-icon="flame" data-icon-size="14"></span> Live Arena
          </button>
          <button class="action-btn action-btn-outline header-cta-quote" id="openInstantQuoteBtn"
            onclick="window.QuoteMarketplace.openQuotesModal()" title="Broadcast requirement for instant quotes">
            <span data-react-icon="zap" data-icon-size="14"></span> Quotes
          </button>
          <button class="action-btn action-btn-outline header-cta-ai" id="headerCareAiBtn"
            onclick="window.CareAI.openAssistantWithQuery()" title="Open CareAI 3.0 Concierge">
            <span data-react-icon="sparkles" data-icon-size="14" style="color: var(--ai-purple);"></span> Ask CareAI
          </button>
        </div>

        <!-- Desktop Secondary Quick Links -->
        <div class="header-tools-group">
          <button class="action-btn action-btn-ghost header-tool-pill jd-header-pill" id="headerJdPayBtn"
            onclick="window.JDFeatures.openJdPayModal()" title="LocalCare Pay: Recharges, Utility Bills & Fast Pay">
            <span data-react-icon="creditCard" data-icon-size="14"></span> LocalCare Pay
          </button>
          <button class="action-btn action-btn-ghost header-tool-pill jd-header-pill" id="headerMoversBtn"
            onclick="window.JDFeatures.openPackersMoversModal()" title="Instant Packers & Movers Fare Estimator">
            <span data-react-icon="package" data-icon-size="14"></span> Movers
          </button>
          <button class="action-btn action-btn-ghost header-tool-pill" id="headerEstimatorBtn"
            onclick="window.CostEstimator.openEstimator()" title="Instant Price Estimator">
            <span data-react-icon="rupee" data-icon-size="14"></span> Rates
          </button>
          <button class="action-btn action-btn-ghost header-tool-pill" id="headerShieldBtn"
            onclick="window.ShieldGuarantee.openShieldModal()" title="LocalCare ₹10,000 Quality Shield">
            <span data-react-icon="shield" data-icon-size="14"></span> Shield
          </button>
          <button class="action-btn action-btn-ghost header-tool-pill" id="openBizPortalBtn"
            onclick="window.BusinessDashboard.openPortal('overview')" title="Business Owner Dashboard & Partner Center">
            <span data-react-icon="briefcase" data-icon-size="14"></span> Partners <span class="biz-ai-badge"
              style="font-size: 0.62rem; padding: 1px 5px; margin-left: 2px;">AI</span>
          </button>
          <button class="action-btn action-btn-outline header-tool-pill jd-free-listing-btn" id="openListBusinessBtn"
            title="Register your business free on LocalCare Infinity">
            <span data-react-icon="plus" data-icon-size="14"></span> Free Listing
          </button>
          <button class="action-btn action-btn-ghost header-tool-pill" id="openAdminBtn"
            onclick="window.AdminPanel.openAdmin()" title="Admin Command Center">
            <span data-react-icon="shieldCheck" data-icon-size="14"></span> Admin
          </button>
          <a href="/admin-crm.html" class="action-btn action-btn-ghost header-tool-pill" id="openCrmBtn"
            title="Central Management System & Google Sheets CRM"
            style="text-decoration: none; color: inherit; display: inline-flex; align-items: center; gap: 0.35rem;">
            <span data-react-icon="barChart" data-icon-size="14"></span> CRM Hub <span
              style="font-size: 0.62rem; padding: 1px 5px; background: rgba(2, 132, 199, 0.15); color: #0284c7; border-radius: 999px; font-weight: 700;">SYNC</span>
          </a>
        </div>

        <!-- Quick Icon Utilities & Profile -->
        <div class="header-utils-group">
          <!-- Notification Bell -->
          <button class="saved-btn notification-btn" id="headerNotificationBtn"
            onclick="window.LocalCare.openNotificationCenter()" title="Notifications & Activity Alerts"
            aria-label="Notifications Center">
            <span data-react-icon="bell" data-icon-size="18"></span>
            <span class="badge-count" id="notificationCountBadge">3</span>
          </button>
          <button class="saved-btn" id="openSavedBtn" title="View Saved Listings" aria-label="Saved Listings">
            <span data-react-icon="heart" data-icon-size="18"></span>
            <span class="badge-count" id="savedCountBadge">0</span>
          </button>
          <button class="sound-toggle-btn" id="soundToggleBtn" onclick="window.SoundFX.toggleMute()"
            title="Toggle Sound Cues" aria-label="Toggle Sound Effects" data-react-icon="volume2" data-icon-size="18">
          </button>
          <button class="shortcuts-btn" id="shortcutsBtn" onclick="window.LocalCare.openShortcutsModal()"
            title="Keyboard Shortcuts (Press ?)" aria-label="Keyboard Shortcuts" data-react-icon="keyboard"
            data-icon-size="18">
          </button>
          <button class="user-avatar-btn" id="userProfileBtn" onclick="window.UserDashboard.openDashboard()"
            title="My Account & Bookings">
            <span class="user-avatar-initials">CK</span>
            <span class="user-name-text">Chethan</span>
          </button>
          <button class="theme-toggle-btn" id="themeToggleBtn" title="Toggle Theme" aria-label="Toggle Dark Mode"
            data-react-icon="moon" data-icon-size="18">
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Mobile Navigation Slide-Out Drawer -->
  <div class="mobile-nav-backdrop" id="mobileNavBackdrop"></div>
  <aside class="mobile-nav-drawer" id="mobileNavDrawer" aria-label="Mobile Navigation Menu">
    <div class="drawer-header">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.3rem;">📍</span>
        <span style="font-weight: 800; font-size: 1.1rem;">LocalCare <span class="infinity-badge">Infinity</span></span>
      </div>
      <button class="dialog-close-btn" id="closeMobileDrawerBtn" aria-label="Close menu">✕</button>
    </div>
    <div class="drawer-body">
      <div>
        <div class="drawer-section-title">Portals & Actions</div>
        <div class="drawer-links-column">
          <button class="drawer-nav-link"
            onclick="window.CareAI.openAssistantWithQuery(); window.LocalCare.closeMobileDrawer();">
            <span data-react-icon="sparkles" data-icon-size="16"></span> Ask CareAI Concierge
          </button>
          <button class="drawer-nav-link"
            onclick="window.QuoteMarketplace.openQuotesModal(); window.LocalCare.closeMobileDrawer();">
            <span data-react-icon="zap" data-icon-size="16"></span> Get 3 Free Quotes
          </button>
          <button class="drawer-nav-link"
            onclick="window.CostEstimator.openEstimator(); window.LocalCare.closeMobileDrawer();">
            <span data-react-icon="rupee" data-icon-size="16"></span> Smart Cost Estimator
