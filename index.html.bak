          <div class="destination-card" style="border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-body); cursor: pointer; transition: all var(--transition-fast);" onclick="window.LocalCare.setCity('Delhi NCR'); window.LocalCare.filterCategory('all');" onmouseover="this.style.transform='translateY(-4px)'; this.style.borderColor='var(--primary)';" onmouseout="this.style.transform='none'; this.style.borderColor='var(--border-subtle)';">
