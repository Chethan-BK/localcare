         ========================================================================== -->
    <section class="categories-section" id="categoriesSection">
      <div class="container">
        <div class="section-header">
          <div>
            <h2 class="section-title">Explore Essential Categories</h2>
            <p class="section-desc">Verified background-checked providers for personal, home & emergency needs</p>
          </div>
          <button class="action-btn action-btn-ghost" id="clearCategoryFilterBtn"
            onclick="window.LocalCare.filterCategory('all')">
            Reset Category
          </button>
        </div>

        <div class="category-grid" id="categoryGrid">
          <!-- Rendered dynamically from CATEGORIES in data.js -->
        </div>
      </div>
    </section>

    <!-- ==========================================================================
         Airbnb/Urban Company Sticky Sub-Nav Category & Quick Filter Bar
         ========================================================================== -->
    <div class="sticky-subnav-bar" id="stickySubnavBar">
      <div class="sticky-subnav-container">
        <!-- Horizontal Scrollable Category Chips with Live Counts -->
        <div class="sticky-chips-scroll" id="stickyChipsScroll" aria-label="Quick Category Filter">
          <!-- Rendered dynamically -->
        </div>

        <!-- Quick Budget Range & Filter Pills -->
        <div class="sticky-filter-actions">
          <button class="sticky-chip-btn" id="stickyBudgetBtn" onclick="window.LocalCare.toggleBudgetPopup(event)">
            <span data-react-icon="rupee" data-icon-size="14"></span> <span id="stickyBudgetLabel">Any Budget</span>
            <span data-react-icon="chevronDown" data-icon-size="11"></span>
          </button>
          <button class="sticky-chip-btn" id="stickyRatingBtn" onclick="window.LocalCare.toggleRatingFilter()">
            <span data-react-icon="starFilled" data-icon-size="14" class="react-icon-gold"></span> 4.5+ Rating
          </button>
          <button class="sticky-chip-btn" id="stickyMapToggleBtn" onclick="window.LocalCare.toggleSplitMap()">
            <span data-react-icon="map" data-icon-size="14"></span> <span id="stickyMapLabel">Show Map</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Budget Popup Sheet Dropdown -->
    <div class="budget-popup-card" id="budgetPopupCard"
      style="display: none; position: fixed; top: 125px; right: 2rem; z-index: 1100; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 1.25rem; box-shadow: var(--shadow-xl); width: 300px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <h4 style="font-size: 0.95rem; font-weight: 800; margin: 0;">Budget Filter</h4>
        <button class="dialog-close-btn" onclick="window.LocalCare.closeBudgetPopup()"
          style="font-size: 0.9rem;">✕</button>
      </div>
      <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem;">
        <button class="action-btn action-btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;"
          onclick="window.LocalCare.applyQuickBudget(null)">All</button>
        <button class="action-btn action-btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;"
          onclick="window.LocalCare.applyQuickBudget(500)">Under ₹500</button>
        <button class="action-btn action-btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;"
          onclick="window.LocalCare.applyQuickBudget(1000)">Under ₹1,000</button>
        <button class="action-btn action-btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;"
          onclick="window.LocalCare.applyQuickBudget(2500)">Under ₹2,500</button>
      </div>
      <div style="margin-bottom: 0.5rem; font-size: 0.82rem; display: flex; justify-content: space-between;">
        <span>Max Budget:</span>
        <strong style="color: var(--primary);" id="budgetSliderDisplay">₹1,500</strong>
      </div>
      <input type="range" min="300" max="5000" step="100" value="1500" id="budgetRangeInput"
        style="width: 100%; accent-color: var(--primary);"
        oninput="window.LocalCare.onBudgetSliderChange(this.value)" />
    </div>

    <!-- ==========================================================================
         Listings & Interactive Map Split Layout
         ========================================================================== -->
    <section class="listings-section" id="listingsSection">
      <div class="container">

        <!-- Filter & Sorting Control Bar -->
        <div class="filter-toolbar">
          <div class="toolbar-left">
            <span class="results-count-badge" id="resultsCount">Loading verified listings...</span>
            <div class="active-filter-tags" id="activeFilterTags"></div>
          </div>

          <div class="toolbar-right">
            <!-- View Mode Switcher -->
            <div class="view-modes-group" role="group" aria-label="Listings View Mode">
              <button class="view-mode-btn active" id="viewGridBtn" title="Grid View">
                <span data-react-icon="grid" data-icon-size="14"></span> Grid
              </button>
              <button class="view-mode-btn" id="viewListBtn" title="List View">
                <span data-react-icon="list" data-icon-size="14"></span> List
              </button>
              <button class="view-mode-btn" id="viewMapBtn" title="Map Focus">
                <span data-react-icon="map" data-icon-size="14"></span> Map
              </button>
            </div>

            <button class="quick-filter-toggle" id="filterVerifiedBtn">
              <span data-react-icon="checkCircle" data-icon-size="14"></span> Verified Only
            </button>
            <button class="quick-filter-toggle" id="filterOpenNowBtn">
              <span data-react-icon="clock" data-icon-size="14"></span> Open Now
            </button>
            <button class="quick-filter-toggle" id="filterAvailableTodayBtn">
              <span data-react-icon="zap" data-icon-size="14"></span> Available Today
            </button>
            <button class="quick-filter-toggle" id="filterRatingBtn">
              <span data-react-icon="starFilled" data-icon-size="14" class="react-icon-gold"></span> 4.8+ Rating
            </button>
