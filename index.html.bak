  <!-- Mobile Floating Map / List Toggle Button -->
  <button class="mobile-map-toggle-btn" id="mobileMapToggleBtn" onclick="window.LocalCare.toggleMobileMap()">
    <span>🗺️</span> View Map
  </button>

  <!-- ==========================================================================
       Modals & Dialogs Container
       ========================================================================== -->

  <!-- 1. Business Detail Profile Modal -->
  <dialog id="detailDialog" class="app-dialog" style="width: 740px;" aria-labelledby="detailModalTitle">
    <div class="dialog-content-wrapper">
      <div class="dialog-header">
        <h3 class="dialog-title" id="detailModalTitle">Business Profile</h3>
        <button class="dialog-close-btn" data-close-dialog aria-label="Close dialog">✕</button>
      </div>
      <div class="dialog-body" id="detailContent" style="padding: 0;">
        <!-- Populated dynamically in app.js -->
      </div>
      <div class="dialog-footer">
        <button class="action-btn action-btn-ghost" data-close-dialog>Close</button>
        <button class="action-btn action-btn-outline" id="detailTrustScoreBtn">
          🛡️ View Trust Audit
        </button>
        <button class="action-btn action-btn-primary" id="detailBookNowBtn">
          Book Appointment
        </button>
      </div>
    </div>
  </dialog>

  <!-- 2. "Call Now" Direct Contact Modal -->
  <dialog id="callDialog" class="app-dialog" style="width: 440px;" aria-labelledby="callDialogTitle">
    <div class="dialog-content-wrapper">
      <div class="dialog-header">
        <h3 class="dialog-title" id="callDialogTitle">Verified Direct Contact</h3>
        <button class="dialog-close-btn" data-close-dialog aria-label="Close dialog">✕</button>
      </div>
      <div class="dialog-body" id="callModalContent">
        <!-- Populated dynamically -->
      </div>
    </div>
  </dialog>

  <!-- 3. "List Your Business" Vendor Multi-Step Onboarding Modal -->
  <dialog id="vendorDialog" class="app-dialog" style="width: 620px;" aria-labelledby="vendorDialogTitle">
    <div class="dialog-content-wrapper">
      <div class="dialog-header">
        <div>
          <h3 class="dialog-title" id="vendorDialogTitle">List Your Business on LocalCare</h3>
          <small style="color: var(--text-secondary);">Join 15,000+ verified businesses getting customer leads
            daily</small>
        </div>
        <button class="dialog-close-btn" data-close-dialog aria-label="Close dialog">✕</button>
      </div>

      <!-- Step Indicator -->
      <div style="padding: 1.25rem 1.5rem 0 1.5rem;">
        <div class="booking-stepper-bar" style="background: transparent; padding: 0;">
          <div class="booking-step active" id="vendorStep1">
            <span class="step-num">1</span>
            <span class="step-text">Identity</span>
          </div>
          <div class="booking-step-line"></div>
          <div class="booking-step" id="vendorStep2">
            <span class="step-num">2</span>
            <span class="step-text">Contact</span>
          </div>
          <div class="booking-step-line"></div>
          <div class="booking-step" id="vendorStep3">
            <span class="step-num">3</span>
            <span class="step-text">Services</span>
          </div>
        </div>
      </div>

      <form id="vendorForm">
        <div class="dialog-body">
          <!-- Step 1: Basic Information -->
          <div id="vStep1Content">
            <h4 style="font-size: 1.05rem; margin-bottom: 1rem;">Step 1: Business Identity</h4>

            <div class="form-group">
              <label class="form-label">Business / Clinic / Agency Name *</label>
              <input type="text" id="vendorBusinessName" class="form-input" placeholder="e.g. Metro Dental Studio"
                required />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Category *</label>
                <select id="vendorCategorySelect" class="form-select" required></select>
              </div>
              <div class="form-group">
                <label class="form-label">City *</label>
                <select id="vendorCitySelect" class="form-select" required></select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Locality / Neighborhood *</label>
              <input type="text" id="vendorLocality" class="form-input" placeholder="e.g. Indiranagar / Valachil"
                required />
            </div>

            <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
              <button type="button" class="action-btn action-btn-primary" id="vendorNextStep1">Next: Contact Info
                ➔</button>
            </div>
          </div>

          <!-- Step 2: Contact Information -->
          <div id="vStep2Content" style="display: none;">
            <h4 style="font-size: 1.05rem; margin-bottom: 1rem;">Step 2: Contact & Location</h4>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Primary Calling Phone *</label>
                <input type="tel" id="vendorPhone" class="form-input" placeholder="+91 98450 00112" required />
              </div>
              <div class="form-group">
                <label class="form-label">WhatsApp Number</label>
                <input type="tel" id="vendorWhatsApp" class="form-input" placeholder="919845000112" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Full Street Address</label>
              <textarea id="vendorAddress" class="form-textarea" rows="2"
                placeholder="Building name, street, landmarks, pincode..."></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Operating Hours</label>
              <input type="text" id="vendorHours" class="form-input" placeholder="e.g. 9:00 AM - 9:00 PM (Mon-Sat)" />
            </div>

            <div style="display: flex; justify-content: space-between; margin-top: 1rem;">
              <button type="button" class="action-btn action-btn-outline" id="vendorPrevStep2">⬅ Back</button>
              <button type="button" class="action-btn action-btn-primary" id="vendorNextStep2">Next: Services & Submit
                ➔</button>
            </div>
          </div>

          <!-- Step 3: Services & Details -->
          <div id="vStep3Content" style="display: none;">
            <h4 style="font-size: 1.05rem; margin-bottom: 1rem;">Step 3: Services & Starting Rate</h4>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Primary Service Offered</label>
                <input type="text" id="vendorService1" class="form-input" placeholder="e.g. Consultation / Repair" />
              </div>
              <div class="form-group">
                <label class="form-label">Starting Price / Consultation</label>
                <input type="text" id="vendorPrice1" class="form-input" placeholder="e.g. ₹399" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Business Description</label>
              <textarea id="vendorDescription" class="form-textarea" rows="3"
                placeholder="Describe your experience, certifications, and specializations..."></textarea>
            </div>

            <div style="display: flex; justify-content: space-between; margin-top: 1rem;">
              <button type="button" class="action-btn action-btn-outline" id="vendorPrevStep3">⬅ Back</button>
              <button type="submit" class="action-btn action-btn-primary">🎉 Publish Listing Now</button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </dialog>

  <!-- 4. Saved Favorites Side Drawer -->
  <div class="drawer-backdrop" id="savedDrawerBackdrop"
    style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1050; display: none;"></div>
  <aside class="side-drawer" id="savedDrawer"
    style="position: fixed; top: 0; right: -420px; width: 400px; max-width: 90vw; height: 100vh; background: var(--bg-surface); z-index: 1051; display: flex; flex-direction: column; transition: right 0.3s ease; box-shadow: var(--shadow-xl);"
    aria-label="Saved Listings">
    <div
      style="display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-subtle);">
      <h3 style="font-size: 1.15rem; font-weight: 700;">❤️ Saved Favorites</h3>
      <button class="dialog-close-btn" id="closeSavedBtn" aria-label="Close saved drawer">✕</button>
    </div>
    <div style="flex: 1; overflow-y: auto; padding: 1rem;" id="savedListingsContainer">
      <!-- Populated dynamically -->
    </div>
  </aside>

  <!-- Keyboard Shortcuts Helper Dialog -->
  <dialog id="shortcutsDialog" class="app-dialog shortcuts-dialog" aria-labelledby="shortcutsTitle">
    <div class="dialog-content-wrapper shortcuts-modal-wrapper" style="width: 540px; max-width: 95vw;">
      <div class="dialog-header">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 1.4rem;">⌨️</span>
          <div>
            <h3 class="dialog-title" id="shortcutsTitle">Keyboard Power Shortcuts</h3>
            <small style="color: var(--text-secondary);">Supercharge your navigation on LocalCare</small>
          </div>
        </div>
        <button class="dialog-close-btn" onclick="document.getElementById('shortcutsDialog').close()">✕</button>
      </div>
      <div class="dialog-body shortcuts-list-grid"
        style="display: grid; grid-template-columns: 1fr; gap: 0.65rem; padding: 1.25rem;">
        <div class="shortcut-item"><kbd>/</kbd> or <kbd>Ctrl+K</kbd> <span>Focus AI Search Omnibox</span></div>
        <div class="shortcut-item"><kbd>M</kbd> <span>Toggle Interactive Vector Map (Mobile / Desktop)</span></div>
        <div class="shortcut-item"><kbd>A</kbd> <span>Open CareAI 2.0 Concierge</span></div>
        <div class="shortcut-item"><kbd>C</kbd> <span>Open Pro Comparison Matrix</span></div>
        <div class="shortcut-item"><kbd>P</kbd> <span>Open Instant Price Estimator</span></div>
        <div class="shortcut-item"><kbd>E</kbd> <span>Trigger 24/7 SOS Emergency Hub</span></div>
        <div class="shortcut-item"><kbd>O</kbd> <span>Open AI Prescription & Service Bill OCR Studio</span></div>
        <div class="shortcut-item"><kbd>W</kbd> <span>Open In-App WhatsApp Web Concierge</span></div>
        <div class="shortcut-item"><kbd>V</kbd> <span>Open CareVision AI Photo Diagnostics</span></div>
        <div class="shortcut-item"><kbd>H</kbd> <span>Open Multilingual Voice Health & Symptom Triage</span></div>
        <div class="shortcut-item"><kbd>B</kbd> <span>Open Partner AI Co-Pilot & QuoteCraft Studio</span></div>
        <div class="shortcut-item"><kbd>T</kbd> <span>Toggle Dark / Light Theme</span></div>
        <div class="shortcut-item"><kbd>S</kbd> <span>Toggle Audio Sound Cues</span></div>
        <div class="shortcut-item"><kbd>?</kbd> <span>Show this Shortcuts Guide</span></div>
        <div class="shortcut-item"><kbd>Esc</kbd> <span>Close Any Open Dialog / Modal</span></div>
      </div>
      <div class="dialog-footer">
        <button class="action-btn action-btn-primary" onclick="document.getElementById('shortcutsDialog').close()">
          Got It!
        </button>
      </div>
    </div>
  </dialog>

  <!-- Notification Center Flyout Drawer -->
  <div class="notification-drawer-backdrop" id="notificationBackdrop"
    onclick="window.LocalCare.closeNotificationCenter()"
    style="position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1050; display: none;"></div>
  <aside class="notification-drawer" id="notificationDrawer"
    style="position: fixed; top: 0; right: -420px; width: 400px; max-width: 92vw; height: 100vh; background: var(--bg-surface); z-index: 1051; display: flex; flex-direction: column; transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: var(--shadow-xl); border-left: 1px solid var(--border-subtle);"
    aria-label="Notifications Center">
    <div
      style="display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-subtle);">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.3rem;">🔔</span>
        <h3 style="font-size: 1.15rem; font-weight: 800; margin: 0;">Notifications & Activity</h3>
      </div>
      <button class="dialog-close-btn" onclick="window.LocalCare.closeNotificationCenter()"
        aria-label="Close notifications">✕</button>
    </div>
    <div
      style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1.5rem; background: var(--bg-subtle); border-bottom: 1px solid var(--border-subtle); font-size: 0.8rem;">
      <span style="color: var(--text-muted);" id="notificationStatusText">3 unread notifications</span>
      <button class="action-btn action-btn-ghost" style="padding: 0.2rem 0.5rem; font-size: 0.78rem;"
        onclick="window.LocalCare.markAllNotificationsRead()">Mark all as read</button>
    </div>
    <div style="flex: 1; overflow-y: auto; padding: 1rem;" id="notificationListContainer">
      <!-- Populated dynamically -->
    </div>
  </aside>

  <!-- Toast Notification Container -->
  <div class="toast-container" id="toastContainer" role="status" aria-live="polite"></div>

  <!-- ==========================================================================
       Justdial-Style Modals Suite
       ========================================================================== -->

  <!-- 1. "Get Best Deal" Instant Multi-Vendor Lead Modal -->
  <dialog id="jdBestDealDialog" class="app-dialog" style="width: 580px; max-width: 95vw;"
    aria-labelledby="jdBestDealTitle">
    <div class="dialog-content-wrapper">
      <div class="dialog-header">
        <div>
          <h3 class="dialog-title" id="jdBestDealTitle">⚡ Get Best Deal in 15 Minutes</h3>
          <small style="color: var(--text-secondary);" id="jdBestDealSubtitle">Get competitive price quotes from top 5
            verified pros near you</small>
        </div>
        <button class="dialog-close-btn" data-close-dialog aria-label="Close dialog">✕</button>
      </div>

      <div class="dialog-body">
        <form id="jdBestDealForm">
          <div class="form-group">
            <label class="form-label">What service or repair do you need? *</label>
            <input type="text" id="jdDealServiceInput" class="form-input"
              placeholder="e.g. Split AC servicing, Root canal, 2BHK Deep cleaning..." required />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">When do you need it? *</label>
              <select id="jdDealUrgencySelect" class="form-select">
                <option value="Urgent (Within 2 Hours)">🚨 Urgent (Within 2 Hours)</option>
                <option value="Today" selected>⚡ Today</option>
                <option value="Tomorrow">📅 Tomorrow</option>
                <option value="This Weekend">🗓️ This Weekend</option>
                <option value="Flexible">🕒 Flexible</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Budget Preference</label>
              <select id="jdDealBudgetSelect" class="form-select">
                <option value="Economy">💵 Economy / Best Value</option>
                <option value="Standard" selected>⚖️ Standard / Quality First</option>
                <option value="Premium">💎 Premium / Master Pro</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Your Name *</label>
              <input type="text" id="jdDealNameInput" class="form-input" value="Chethan B K"
                placeholder="Enter full name" required />
            </div>
            <div class="form-group">
              <label class="form-label">Mobile Number (For Quotes & Callback) *</label>
              <input type="tel" id="jdDealPhoneInput" class="form-input" value="+91 98450 11223"
                placeholder="+91 98450 00000" required />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Specific Details / Brand / Notes</label>
            <textarea id="jdDealNotesInput" class="form-textarea" rows="2"
              placeholder="e.g. Daikin 1.5 ton split AC, water leakage in indoor unit..."></textarea>
          </div>

          <div
            style="background: var(--bg-subtle); border-radius: var(--radius-md); padding: 0.75rem 1rem; margin-bottom: 1.25rem; font-size: 0.82rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;">
            <span>🛡️</span>
            <span><strong>100% Free & No Spam:</strong> Your request is sent only to 3-5 background-verified
              partners.</span>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
            <button type="button" class="action-btn action-btn-ghost" data-close-dialog>Cancel</button>
            <button type="submit" class="action-btn action-btn-primary"
              style="padding: 0.75rem 1.5rem; font-size: 0.95rem;">
              <span>⚡</span> Broadcast & Get Quotes
            </button>
          </div>
        </form>

        <div id="jdBestDealSuccess" style="display: none;"></div>
      </div>
    </div>
  </dialog>

  <!-- 2. "JD Pay" Mobile Recharge & Utility Bills Hub Modal -->
  <dialog id="jdPayDialog" class="app-dialog" style="width: 620px; max-width: 95vw;" aria-labelledby="jdPayTitle">
    <div class="dialog-content-wrapper">
      <div class="dialog-header">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <span style="font-size: 1.6rem;">💳</span>
          <div>
            <h3 class="dialog-title" id="jdPayTitle">JD Pay — Bills & Instant Recharges</h3>
            <small style="color: var(--text-secondary);">Fast, secure payments with flat 5% cashback on all
              utilities</small>
          </div>
        </div>
        <button class="dialog-close-btn" data-close-dialog aria-label="Close dialog">✕</button>
      </div>

      <!-- Navigation Tabs -->
      <div class="jdpay-tabs-bar">
        <button class="jdpay-tab-btn active" data-tab="recharge" onclick="window.JDFeatures.switchJdPayTab('recharge')">
          <span>📱</span> Mobile Recharge
        </button>
        <button class="jdpay-tab-btn" data-tab="electricity" onclick="window.JDFeatures.switchJdPayTab('electricity')">
          <span>⚡</span> Electricity Bill
        </button>
        <button class="jdpay-tab-btn" data-tab="directpay" onclick="window.JDFeatures.switchJdPayTab('directpay')">
          <span>🛍️</span> Pay Any Business
        </button>
      </div>

      <div class="dialog-body">
        <!-- Tab 1: Mobile Recharge -->
        <div class="jdpay-tab-content active" id="jdpay-recharge">
          <form id="jdpayRechargeForm">
            <!-- Operator Pill Selector -->
            <div style="margin-bottom: 1rem;">
              <label class="form-label">Select Operator</label>
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <button type="button" class="jdpay-op-btn active" data-op="jio">Jio 5G</button>
                <button type="button" class="jdpay-op-btn" data-op="airtel">Airtel 5G</button>
                <button type="button" class="jdpay-op-btn" data-op="vi">Vodafone Idea</button>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Mobile Number *</label>
                <input type="tel" id="jdpayMobileInput" class="form-input" value="9845011223" maxlength="10"
                  placeholder="10-digit number" required />
              </div>
              <div class="form-group">
                <label class="form-label">Recharge Amount (₹) *</label>
                <input type="number" id="jdpayAmountInput" class="form-input" value="299" required />
              </div>
            </div>

            <div style="margin-bottom: 0.75rem; font-weight: 700; font-size: 0.88rem; color: var(--text-primary);">
              ⚡ Popular Recommended Plans:
            </div>
            <div class="jdpay-plans-grid" id="jdpayPlansGrid">
              <!-- Populated dynamically -->
            </div>

            <div id="jdpayRechargeResult" style="margin: 1rem 0; display: none;"></div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem;">
              <span style="font-size: 0.82rem; color: #059669; font-weight: 700;">🎁 5% Cashback up to ₹25 with JD
                Pay</span>
              <button type="submit" class="action-btn action-btn-primary" style="padding: 0.75rem 1.5rem;">
                Proceed to Recharge ➔
              </button>
            </div>
          </form>
        </div>

        <!-- Tab 2: Electricity Bill -->
        <div class="jdpay-tab-content" id="jdpay-electricity">
          <div class="form-group">
            <label class="form-label">Select Electricity Provider *</label>
            <select id="jdpayBoardSelect" class="form-select">
              <option value="bescom">BESCOM - Bangalore Electricity Supply (Karnataka)</option>
              <option value="mescom">MESCOM - Mangalore Electricity Supply (Karnataka)</option>
              <option value="msedcl">MSEDCL - Mahavitaran (Maharashtra)</option>
              <option value="bses">BSES Yamuna Power Limited (Delhi NCR)</option>
              <option value="tsspdcl">TSSPDCL (Hyderabad / Telangana)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Consumer Account ID / Meter Number *</label>
            <div style="display: flex; gap: 0.5rem;">
              <input type="text" id="jdpayConsumerIdInput" class="form-input" value="54810294"
                placeholder="Enter Consumer Account ID" />
              <button type="button" class="action-btn action-btn-primary"
                onclick="window.JDFeatures.handleFetchElectricityBill()">
                Fetch Bill ➔
              </button>
            </div>
          </div>

          <div id="jdpayElectricityBillBox" style="display: none; margin-top: 1rem;"></div>
        </div>

        <!-- Tab 3: Pay Any Business Direct -->
        <div class="jdpay-tab-content" id="jdpay-directpay">
          <div class="form-group">
            <label class="form-label">Select Local Merchant / Clinic / Service</label>
            <select id="jdpayMerchantSelect" class="form-select">
              <option value="b-101">Apollo Dental & Laser Clinic (Koramangala)</option>
              <option value="b-102">QuickFix Pro AC & Electricals (HSR Layout)</option>
              <option value="b-103">RapidFlow 24/7 Plumbers (Indiranagar)</option>
              <option value="b-113">SafeMove India Packers & Movers (HSR Layout)</option>
              <option value="b-201">Mangalore Care PolyClinic (Valachil)</option>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Bill Amount (₹)</label>
              <input type="number" id="jdpayDirectAmount" class="form-input" value="1000" />
            </div>
            <div class="form-group">
              <label class="form-label">Promo Coupon</label>
              <input type="text" id="jdpayCouponCode" class="form-input" value="JDPAY50" readonly />
            </div>
          </div>

          <div
            style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: var(--radius-md); padding: 0.75rem 1rem; margin-bottom: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div>
                <strong style="color: #065f46; font-size: 0.95rem;">Coupon JDPAY50 Applied!</strong>
                <div style="font-size: 0.78rem; color: #047857;">Instant ₹50 Discount + 5% JD Pay Wallet Rewards</div>
              </div>
              <span style="font-weight: 800; font-size: 1.2rem; color: #065f46;">₹950 Payable</span>
            </div>
          </div>

          <button class="action-btn action-btn-primary" style="width: 100%; justify-content: center; padding: 0.85rem;"
            onclick="window.LocalCare.showToast('Payment successful! Receipt & OTP sent to merchant.', 'success'); document.getElementById('jdPayDialog').close();">
            💳 Pay ₹950 via UPI / Card & Confirm
          </button>
        </div>
      </div>
    </div>
  </dialog>

  <!-- 3. Packers & Movers Fare & Route Estimator Modal -->
  <dialog id="jdPackersMoversDialog" class="app-dialog" style="width: 600px; max-width: 95vw;"
    aria-labelledby="pmModalTitle">
    <div class="dialog-content-wrapper">
      <div class="dialog-header">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <span style="font-size: 1.6rem;">📦</span>
          <div>
            <h3 class="dialog-title" id="pmModalTitle">Packers & Movers Fare Calculator</h3>
            <small style="color: var(--text-secondary);">Instant transparent estimate • Zero hidden charges • IBA
              approved movers</small>
          </div>
        </div>
        <button class="dialog-close-btn" data-close-dialog aria-label="Close dialog">✕</button>
      </div>

      <div class="dialog-body">
        <form id="pmLeadForm">
          <!-- Route & Distance -->
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Pickup Area *</label>
              <input type="text" id="pmFromAreaInput" class="form-input" value="HSR Layout, Bengaluru"
                placeholder="Pickup Area" required />
            </div>
            <div class="form-group">
              <label class="form-label">Drop Area *</label>
              <input type="text" id="pmToAreaInput" class="form-input" value="Whitefield, Bengaluru"
                placeholder="Drop Area" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Movement Type *</label>
              <select id="pmMoveTypeSelect" class="form-select">
                <option value="local" selected>Within City (Local Move)</option>
                <option value="intercity">Intercity (Between 2 Cities)</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Packaging Quality</label>
              <select id="pmPackingTierSelect" class="form-select">
                <option value="standard" selected>Standard (Cardboard & Shrink Wrap)</option>
                <option value="premium">Premium (5-Layer Bubble Foam & Wooden Crates)</option>
              </select>
            </div>
          </div>

          <!-- Dynamic Room-by-Room Inventory Section -->
          <div
            style="margin: 0.75rem 0 0.5rem 0; font-weight: 800; font-size: 0.9rem; color: var(--text-primary); display: flex; justify-content: space-between; align-items: center;">
            <span>📦 Room-by-Room Inventory Picker:</span>
            <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: normal;">Click + / - to adjust
              household items</span>
          </div>
          <div id="pmRoomInventoryContainer"></div>

          <!-- Live Volume Cockpit Meter & Vehicle Match -->
          <div class="pm-volume-cockpit" style="margin: 1rem 0;">
            <div class="pm-gauge-col">
              <div class="pm-gauge-header">
                <strong>Volume: <span id="pmTotalCftDisplay" style="color: var(--primary);">260 CFT</span></strong>
                <span style="font-size: 0.75rem; color: var(--text-muted);">Cubic Feet</span>
              </div>
              <div class="pm-gauge-bar-outer">
                <div class="pm-gauge-bar-inner" id="pmGaugeBar" style="width: 74%;"></div>
              </div>
            </div>
            <div class="pm-vehicle-col">
              <span class="pm-vehicle-icon" id="pmVehicleIcon">🚚</span>
              <div>
                <div style="font-size: 0.72rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">
                  Recommended Vehicle:</div>
                <strong style="font-size: 0.88rem; color: var(--text-primary);" id="pmVehicleName">14ft Eicher
                  (Standard)</strong>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Your Mobile Number (For Verified Mover Callbacks) *</label>
            <input type="tel" id="pmPhoneInput" class="form-input" value="+91 98450 11223" required />
          </div>

          <!-- Dynamic Estimate Display Card -->
          <div class="pm-estimate-box">
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">
              Estimated Shifting Cost Range</div>
            <div style="display: flex; align-items: baseline; gap: 0.5rem; margin: 0.25rem 0;">
              <span class="pm-estimate-digits" id="pmEstimateLow">₹5,500</span>
              <span style="color: var(--text-muted); font-size: 1.2rem;">–</span>
              <span class="pm-estimate-digits" id="pmEstimateHigh">₹8,000</span>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-secondary);">
              Includes truck transport, professional loading/unloading, basic dismantle & assembly. Zero hidden costs.
            </div>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.25rem;">
            <button type="button" class="action-btn action-btn-ghost" data-close-dialog>Close</button>
            <button type="submit" class="action-btn action-btn-primary" style="padding: 0.75rem 1.5rem;">
              <span>🚚</span> Get 3 IBA-Approved Quotes Now
            </button>
          </div>
        </form>

        <div id="pmResultBox" style="display: none;"></div>
      </div>
    </div>
  </dialog>

  <!-- Interactive WhatsApp Web Concierge Simulator Modal -->
  <dialog id="waChatDialog" class="app-dialog" style="width: 520px; max-width: 95vw;" aria-labelledby="waContactName">
