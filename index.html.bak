  <!-- ==========================================================================
       AI Modal 2: AI Problem Matchmaker & Root-Cause Estimator
       ========================================================================== -->
  <dialog class="modal-dialog jd-modal modal-lg" id="aiMatchmakerDialog" aria-labelledby="aiMatchmakerTitle">
    <div class="modal-content-wrapper">
      <div class="modal-header-clean">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <div
            style="width: 44px; height: 44px; border-radius: var(--radius-md); background: linear-gradient(135deg, #ff6800 0%, #f97316 100%); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: #ffffff;">
            ✨
          </div>
          <div>
            <h3 class="modal-clean-title" id="aiMatchmakerTitle">AI Problem Matchmaker & Diagnostic Studio</h3>
            <span style="font-size: 0.8rem; color: var(--text-secondary);">Describe any symptom in your own words — AI
              diagnoses the root cause & matches the best pros</span>
          </div>
        </div>
        <button class="modal-close-icon" onclick="document.getElementById('aiMatchmakerDialog').close()"
          aria-label="Close modal">✕</button>
      </div>

      <div class="modal-clean-body">
        <form onsubmit="window.CareAISuite.handleMatchmakerSubmit(event)" style="margin-bottom: 1rem;">
          <label style="display: block; font-weight: 700; font-size: 0.92rem; margin-bottom: 0.5rem;">
            Describe your problem or symptom (in any language):
          </label>
          <div style="display: flex; gap: 0.5rem;">
            <input type="text" id="matchmakerInput" class="omnibox-input"
              style="flex: 1; padding: 0.8rem 1.1rem; border-radius: var(--radius-md); border: 2px solid var(--border-subtle); font-size: 0.95rem; background: var(--bg-surface);"
              placeholder="e.g., 'Kitchen sink pipe leaking water and smells bad' or 'AC not cooling properly'..."
              required />
            <button type="submit" class="action-btn action-btn-primary"
              style="padding: 0.8rem 1.5rem; font-size: 0.95rem;">
              <span>✨ Diagnose & Match</span>
            </button>
          </div>
        </form>

        <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem;">
          <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); padding: 0.2rem 0;">Try
            examples:</span>
          <button class="action-btn action-btn-ghost jd-pill-sm"
            onclick="document.getElementById('matchmakerInput').value = 'Kitchen sink drainage pipe leaking under slab'; window.CareAISuite.handleMatchmakerSubmit(event);">
            🚰 Sink Pipe Leak
          </button>
          <button class="action-btn action-btn-ghost jd-pill-sm"
            onclick="document.getElementById('matchmakerInput').value = '1.5 ton split AC outdoor unit making loud noise and not cooling'; window.CareAISuite.handleMatchmakerSubmit(event);">
            ❄️ AC Loud Noise
          </button>
          <button class="action-btn action-btn-ghost jd-pill-sm"
            onclick="document.getElementById('matchmakerInput').value = 'Severe toothache on lower molar with cold water sensitivity'; window.CareAISuite.handleMatchmakerSubmit(event);">
            🩺 Toothache Sensitivity
          </button>
          <button class="action-btn action-btn-ghost jd-pill-sm"
            onclick="document.getElementById('matchmakerInput').value = 'Main tripping switch MCB falling repeatedly when geyser turned on'; window.CareAISuite.handleMatchmakerSubmit(event);">
            ⚡ MCB Trip
          </button>
        </div>

        <div id="matchmakerResultsArea"></div>
      </div>
    </div>
  </dialog>

  <!-- ==========================================================================
       Unified Floating AI & Speed-Dial Command Dock (Zero Map Overlap)
       ========================================================================== -->
  <div class="floating-command-dock" id="floatingCommandDock">
    <!-- Collapsible Quick Actions Popup Menu -->
    <div class="command-dock-menu" id="commandDockMenu">
      <button class="command-dock-item" onclick="window.CareAISuite.openDiagnosticScanner()">
        <span class="dock-item-icon">📸</span>
        <div class="dock-item-text">
          <strong>Visual Photo Diagnosis</strong>
          <span>Scan broken pipe, AC frost, dent</span>
        </div>
      </button>
      <button class="command-dock-item" onclick="window.CareAISuite.openPrescriptionOcrModal('prescription')">
        <span class="dock-item-icon">📑</span>
        <div class="dock-item-text">
          <strong>AI Prescription & Bill OCR</strong>
          <span>Generic savings & part pricing</span>
        </div>
      </button>
      <button class="command-dock-item" onclick="window.CareAISuite.openProblemMatchmaker()">
        <span class="dock-item-icon">✨</span>
        <div class="dock-item-text">
          <strong>AI Problem Matchmaker</strong>
          <span>Decompose symptom -> best pros</span>
        </div>
      </button>
      <button class="command-dock-item" onclick="window.JDFeatures.openBestDealModal()">
        <span class="dock-item-icon">⚡</span>
        <div class="dock-item-text">
          <strong>Get Best Deal in 60s</strong>
          <span>Broadcast requirement to 5 pros</span>
        </div>
      </button>
      <button class="command-dock-item" onclick="window.CostEstimator ? window.CostEstimator.openModal() : null">
        <span class="dock-item-icon">🏷️</span>
        <div class="dock-item-text">
          <strong>Fair Cost Estimator</strong>
          <span>Transparent rate breakdown</span>
        </div>
      </button>
    </div>

    <!-- Main Floating Trigger Bar -->
    <div class="command-dock-bar">
      <button class="dock-trigger-btn dock-btn-deal" onclick="window.JDFeatures.openBestDealModal()"
        title="Broadcast requirement & get best quotes in 60s">
        <span class="dock-pulse-dot"></span>
        <span>⚡ Best Deal</span>
      </button>
      <button class="dock-trigger-btn dock-btn-ai" id="dockAiTriggerBtn" onclick="window.CareAISuite.toggleCareAI()"
        title="Open CareAI 2.0 Concierge">
        <span class="dock-sparkle">✨</span>
        <span>CareAI</span>
      </button>
      <button class="dock-menu-toggle-btn" id="dockMenuToggleBtn" onclick="window.CareAISuite.toggleDockMenu()"
        title="More AI Tools" aria-label="More AI Tools">
        <span>▲</span>
      </button>
    </div>
  </div>

