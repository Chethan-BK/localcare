          <span class="recent-searches-label">Recent Searches:</span>
          <div id="recentSearchesList" style="display: flex; gap: 0.4rem; flex-wrap: wrap;"></div>
        </div>

        <!-- AI Conversational Explanation Banner (Hidden until query executed) -->
        <div class="ai-summary-banner" id="aiSummaryBanner" style="display: none;">
          <div id="aiSummaryText"></div>
          <button class="action-btn action-btn-ghost"
            onclick="document.getElementById('aiSummaryBanner').style.display = 'none'">✕</button>
