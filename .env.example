# ==============================================================================
# LocalCare Infinity - Environment Configuration Template
# Copy this file to .env and configure your local or production environment variables.
# Never commit real secrets or production credentials to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# AI Provider API Keys (Optional - Intelligent Rule-Based Engine activates as fallback)
# Supported providers: GEMINI, OPENAI, ANTHROPIC
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Map Provider Configuration (Default: OpenStreetMap / Leaflet with Vector Fallback)
MAP_PROVIDER=osm
MAPBOX_ACCESS_TOKEN=your_mapbox_token_optional
GOOGLE_MAPS_API_KEY=your_google_maps_key_optional

# Database Persistence (Default: Built-in Persistent JSON Store at data/db.json)
DATABASE_URL=postgres://localcare_user:password@localhost:5432/localcare_infinity

# Security & Authentication Secrets
JWT_SECRET=localcare_infinity_super_secret_jwt_key_change_in_production
SESSION_SECRET=session_encryption_key_change_in_production

# SMS & Communication Gateways (Optional)
TWILIO_ACCOUNT_SID=your_twilio_sid_optional
TWILIO_AUTH_TOKEN=your_twilio_token_optional
WHATSAPP_BUSINESS_API_KEY=your_whatsapp_business_key_optional

# Payment Gateway Test Credentials (Razorpay / Cashfree / UPI QR)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
